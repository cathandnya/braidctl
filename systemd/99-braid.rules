# A member of the braid pool appeared. Run a monitor pass now instead of waiting up to
# five minutes for the timer.
#
# This matters most after a USB bus re-enumeration, when every drive comes back under a new
# device node. btrfs will not swap new nodes into an already-mounted filesystem, so the mount
# is left pointing at dead block devices: writes land in page cache, report success, and are
# lost when the filesystem is finally remounted. Only a remount repairs it, and nothing else
# notices — so the window has to be as short as possible.
#
# install.sh rewrites the label below to match /etc/braid/braid.toml.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="btrfs", ENV{ID_FS_LABEL}=="braid", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="braid-monitor-udev.service"

# A member went away. If too few are left for btrfs to place a write, detach the mount so
# writes fail visibly instead of being accepted into page cache and thrown away. `guard`
# decides; losing one drive out of a healthy raid1 deliberately does nothing, because
# surviving that is the whole point of the pool.
#
# Removal events carry the properties udev recorded when the device was added, so
# ID_FS_LABEL still matches here. SYSTEMD_WANTS does NOT work on a remove event — systemd
# only starts units from add/change — so the unit is launched with systemd-run instead.
# --no-block returns immediately, which keeps the work off the udev worker.
ACTION=="remove", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="btrfs", ENV{ID_FS_LABEL}=="braid", \
    RUN+="/usr/bin/systemd-run --no-block --collect --unit=braid-guard -p Nice=-5 -p TimeoutStartSec=60 /usr/local/sbin/braidctl guard"
