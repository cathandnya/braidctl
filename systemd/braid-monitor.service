[Unit]
Description=braid pool monitor (failure detection and auto-rebuild)
After=local-fs.target

[Service]
Type=oneshot
# --if-idle: add / remove がプールのロックを持っている間は静かに諦める。
# device remove は数時間かかることがあり、その間 5 分ごとに失敗ユニットを
# 積み上げると、本当に見るべきときに journal が信用されなくなる。
ExecStart=/usr/local/sbin/braidctl monitor --if-idle
# 再冗長化 (btrfs device remove) は数時間かかることがある
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
