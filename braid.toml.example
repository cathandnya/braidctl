# /etc/braid/braid.toml — braidctl configuration.
# Anything omitted falls back to DEFAULT_CONFIG in braidctl.py.

mountpoint = "/srv/pool"
label = "braid"

# Grace period, in seconds, between noticing a drive is gone and re-laying-out without it.
# Exists so a USB bus glitch that clears in seconds does not trigger a rebuild.
debounce_sec = 600

# A rebuild is considered possible when  used <= usable_after_loss * rebuild_margin
rebuild_margin = 0.95
warn_percent = 90

# Services stopped only for the degraded-remount fallback during a rebuild
samba_units = ["smbd"]

# How often a standing problem is re-reported, in seconds
remind_interval_sec = 86400

# Most USB-SATA bridges need an explicit device type for SMART to work
smart_args = ["-d", "sat"]

# Evict drives that are failing but still present, rather than only reporting them.
# Off by default: a drive throwing occasional errors usually still serves readable copies.
auto_evict_on_errors = false
error_threshold = 10

# Substrings of /dev/disk/by-id names that `add` must always refuse, even with --force.
# Put anything here that must never be absorbed into the pool by a mistyped device node.
protected_devices = []

[notify]
# Any JSON file with a notification.email object of
#   {smtp_server, smtp_port, username, password, from, to, use_tls}
config_file = "/etc/nas-monitor/config.json"
to = ""                     # empty: use the address from config_file
subject_prefix = "[braid]"
